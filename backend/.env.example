# Скопируйте в .env. Без DATABASE_URL/REDIS_URL проект работает на SQLite и кэше в памяти.
ENVIRONMENT=local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000

# DATABASE_URL=postgres://cts:cts@localhost:5432/cts
# REDIS_URL=redis://localhost:6379/0

# CSRF: меняющие запросы с cookie принимаются только с Origin из этого списка (через запятую)
CSRF_TRUSTED_ORIGINS=http://localhost:3000

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# SENTRY_DSN=
