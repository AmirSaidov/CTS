# 1 — работа без бэкенда на моковых данных и эмуляторе WebSocket. В продакшене — пусто.
NEXT_PUBLIC_API_MOCKS=1

# Смешанный режим: эти разделы идут в настоящий Django, остальное — моки (бэкенд готов не целиком).
# Сейчас на бэкенде есть: auth (вход, регистрация, подтверждение, сброс пароля), me, games, plans.
# Пусто — всё на моках; при NEXT_PUBLIC_API_MOCKS=0 список не нужен.
# NEXT_PUBLIC_API_REAL=auth,me,games,plans

# OAuth-провайдеры, уже подключённые на бэкенде (discord,google). Пусто — кнопок входа через соцсети нет.
# NEXT_PUBLIC_OAUTH=

# Django: адрес для SSR (из контейнера/сервера Next) и origin для rewrite /api/v1 → Django
API_INTERNAL_URL=http://localhost:8000/api/v1
API_INTERNAL_ORIGIN=http://localhost:8000

# Браузер: относительный путь (через rewrite) — cookie остаются first-party
NEXT_PUBLIC_API_URL=/api/v1

# WebSocket Django Channels. Пусто — ws(s)://<текущий хост>/ws/
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Экраны, отложенные на v2 (ТЗ на урезание до MVP, раздел 6): по умолчанию выключены и отдают 404.
# FEATURE_SCHEDULE= FEATURE_PLAYER_PROFILE= FEATURE_TEAM_PROFILE= FEATURE_RANKINGS= FEATURE_ABOUT=
# FEATURE_MY_TOURNAMENTS= FEATURE_INVITES= FEATURE_PARTICIPANTS= FEATURE_NOTIFICATION_SETTINGS=
# FEATURE_LOCALE= FEATURE_BILLING= FEATURE_DELETE_ACCOUNT=

# Заявка на Pro / Лигу и «Связаться» на тарифах
# NEXT_PUBLIC_CONTACT_TELEGRAM=https://t.me/cts_gg
